diff --git a/src/lib/tinyio/test.zig b/src/lib/tinyio/test.zig
--- a/src/lib/tinyio/test.zig
+++ b/src/lib/tinyio/test.zig
@@ -656,6 +656,45 @@
+test "fileRealPath rejects truncation" {
+    if (builtin.target.os.tag != .linux) return error.SkipZigTest;
+    const tio: TinyIo = .init;
+    const test_io = tio.io();
+    const testing = std.testing;
+    var tmp_dir = testing.tmpDir(.{});
+    defer tmp_dir.cleanup();
+    try tmp_dir.dir.writeFile(testing.io, .{ .sub_path = "real.txt", .data = "x" });
+    const dir: Dir = .{ .handle = tmp_dir.dir.handle };
+    var file = try dir.openFile(test_io, "real.txt", .{});
+    defer file.close(test_io);
+    var full: [std.Io.Dir.max_path_bytes]u8 = undefined;
+    const n = try file.realPath(test_io, &full);
+    try testing.expect(n > 8);
+    var guarded: [std.Io.Dir.max_path_bytes]u8 = @splat(0xa5);
+    try testing.expectError(error.NameTooLong, file.realPath(test_io, guarded[0..0]));
+    try testing.expectError(error.NameTooLong, file.realPath(test_io, guarded[0..8]));
+    try testing.expectError(error.NameTooLong, file.realPath(test_io, guarded[0 .. n - 1]));
+    for (guarded) |byte| try testing.expectEqual(@as(u8, 0xa5), byte);
+    try testing.expectEqual(n, try file.realPath(test_io, guarded[0..n]));
+    try testing.expectEqualStrings(full[0..n], guarded[0..n]);
+    try testing.expectEqual(@as(u8, 0xa5), guarded[n]);
+    // Non-cwd directory handles always use the fd fallback, even with libc.
+    @memset(&guarded, 0xa5);
+    try testing.expectError(error.NameTooLong, dir.realPathFile(test_io, "real.txt", guarded[0..8]));
+    for (guarded) |byte| try testing.expectEqual(@as(u8, 0xa5), byte);
+    try testing.expectEqual(n, try dir.realPathFile(test_io, "real.txt", guarded[0..n]));
+    try testing.expectEqualStrings(full[0..n], guarded[0..n]);
+    try testing.expectEqual(@as(u8, 0xa5), guarded[n]);
+}
