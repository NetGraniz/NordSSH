+            var resolved: [posix.PATH_MAX]u8 = undefined;
             while (true) {
-                const rc = posix.system.readlink(proc_path, out_buffer.ptr, out_buffer.len);
+                const rc = posix.system.readlink(proc_path, &resolved, resolved.len);
                 switch (posix.errno(rc)) {
-                    .SUCCESS => return @bitCast(rc),
+                    .SUCCESS => {
+                        const n: usize = @bitCast(rc);
+                        if (n == resolved.len or n > out_buffer.len) return error.NameTooLong;
+                        @memcpy(out_buffer[0..n], resolved[0..n]);
+                        return n;
+                    },
                     .INTR => continue,
