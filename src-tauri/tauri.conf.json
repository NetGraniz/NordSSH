{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NordSSH",
  "version": "0.1.0",
  "identifier": "com.nordssh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NordSSH",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFNjRBNkQzN0UwOTgwMEEKUldRS2dBbCswNlprenA4RzE4dzFVVHdWb0diNTVNTHJxUzI4dHNyVHlMT3IyTXNxSnFTMlRZMnQK",
      "endpoints": ["https://github.com/NetGraniz/NordSSH/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Local SSH and SFTP client",
    "longDescription": "SSH terminals, SFTP, saved commands and a portable encrypted vault. No cloud account or telemetry.",
    "category": "DeveloperTool",
    "resources": { "../artifacts/licenses/": "licenses/" },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "startMenuFolder": "NordSSH"
      }
    }
  }
}
